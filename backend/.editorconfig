root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,props,targets,csproj,sln}]
indent_size = 2

[*.cs]
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:suggestion
csharp_style_var_elsewhere = false:none
csharp_style_var_for_built_in_types = false:none
csharp_style_var_when_type_is_apparent = true:none
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning

# Serilog and ASP.NET Core logging are used through the standard ILogger API.
# Source-generated LoggerMessage delegates, and IsEnabled guards around each call,
# are not worth the ceremony at this size. Nothing here logs from a hot path.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
dotnet_diagnostic.MA0144.severity = none

# ASP.NET Core has no synchronisation context, so ConfigureAwait(false) adds noise.
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.CA2007.severity = none

# Minimal API endpoint handlers and composition-root helpers are public by design.
dotnet_diagnostic.CA1515.severity = none

# The repository targets one deployment and one language; culture-aware string APIs
# would hide intent rather than reveal it. Invariant globalization is switched on.
dotnet_diagnostic.MA0011.severity = none
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1311.severity = none

[*.cs]
# Analyzer rules that only make sense for a published library API.
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1034.severity = none

# Entity Framework Core writes the migration files. Reviewing their style is not
# useful, and reformatting them by hand would make the next scaffold noisy.
[**/Persistence/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
dotnet_diagnostic.IDE0161.severity = none

[tests/**/*.cs]
# Test method names read as sentences, and xUnit's own vocabulary decides the
# names of fixtures and collections.
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.S101.severity = none
