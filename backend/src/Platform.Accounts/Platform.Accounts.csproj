<Project Sdk="Microsoft.NET.Sdk">

  <!-- Accounts may reference SharedKernel only. It must not see AgentDelivery:
       the rule "an Employee Agent's rights equal its Employee's rights" is
       checked in AgentDelivery, and a reference back would let it leak. -->
  <ItemGroup>
    <ProjectReference Include="..\Platform.SharedKernel\Platform.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CSharpFunctionalExtensions" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" />
  </ItemGroup>

</Project>
