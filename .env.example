# Copy to .env and fill in. The .env file is ignored by Git, so a clone never
# carries credentials. Every variable the platform reads is listed here.

# The database container.
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me
POSTGRES_DB=platform

# How the backend reaches the database. The host is the Compose service name.
ConnectionStrings__Default=Host=db;Port=5432;Database=platform;Username=platform;Password=change-me

# Development applies each module's migrations at startup. No other environment does.
ASPNETCORE_ENVIRONMENT=Development

# Where the frontend dev server proxies /api and /mcp. The host is the Compose
# service name; outside Compose, use http://localhost:8080.
BACKEND_URL=http://backend:8080
